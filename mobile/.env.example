# Copy to .env for local development overrides.
#
# Where the app finds the Laravel API. If unset, defaults are:
#   Android emulator -> http://10.0.2.2:8090
#   iOS simulator / Expo web -> http://127.0.0.1:8090
#
# For a PHYSICAL phone (Expo Go) on your Wi-Fi, use your machine's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.0.12:8090
#
# EAS builds override this per-profile in eas.json (staging/production URLs).
EXPO_PUBLIC_API_URL=
